{
  "name": "@eval-platform/evaluation",
  "version": "1.0.0",
  "description": "Evaluation module for the Agent Evaluation Platform",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@eval-platform/database": "workspace:*",
    "@eval-platform/llm": "workspace:*",
    "@eval-platform/shared": "workspace:*",
    "axios": "^1.17.0",
    "eventsource-parser": "^3.1.0",
    "p-queue": "^9.3.0"
  }
}
