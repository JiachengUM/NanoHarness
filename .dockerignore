*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info
dist/
build/

# Git 相关
.git/
.gitignore
.gitattributes

# 虚拟环境（所有层级）
**/.venv/
**/venv/
.venv/
venv/

# Node dependencies
**/node_modules/

# 日志文件（所有层级）
*.log
**/*.log

# 系统文件（所有层级）
.DS_Store
**/.DS_Store

# IDE 文件（所有层级）
.vscode/
.idea/
**/.vscode/
**/.idea/

# 测试和缓存（所有层级）
