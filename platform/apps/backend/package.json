{
  "name": "eval-platform-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@eval-platform/database": "workspace:*",
    "@eval-platform/llm": "workspace:*",
    "@eval-platform/makedata": "workspace:*",
    "@eval-platform/shared": "workspace:*",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3"
  }
}
